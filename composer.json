{
  "name": "tetthys/claim-dispatch",
  "description": "Minimal contracts for claim→process→dispatch pipelines, with built-in Laravel adapter.",
  "type": "library",
  "keywords": ["laravel", "claim", "dispatch", "pipeline", "command", "job", "bus"],
  "version": "0.0.2",
  "license": "MIT",
  "authors": [
    {
      "name": "Tetthys",
      "email": "dev@example.com"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "illuminate/support": "^10.0 || ^11.0",
    "illuminate/database": "^10.0 || ^11.0",
    "illuminate/bus": "^10.0 || ^11.0",
    "illuminate/console": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Tetthys\\ClaimDispatch\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tetthys\\ClaimDispatch\\Laravel\\ClaimDispatchServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
